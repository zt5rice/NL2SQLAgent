# LLM provider: "openai_compatible" (default) or "tongyi" (legacy Bailian)
LLM_PROVIDER=openai_compatible

# API key for the LLM provider. OpenCode Go / Zen, OpenRouter, DeepSeek, etc.
LLM_API_KEY=your_api_key_here

# OpenAI-compatible base URL (OpenCode Go by default)
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Model name (OpenCode Go exposes qwen3.7-max / qwen3.8-max, etc.)
LLM_MODEL=qwen3.7-max

# Legacy Alibaba Cloud Bailian settings (only needed for LLM_PROVIDER=tongyi)
# DASHSCOPE_API_KEY=your_api_key_here
# QWEN_MODEL=qwen3-max

# SQLite database connection
DATABASE_URL=sqlite:///./data/app.db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
